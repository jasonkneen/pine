// The relay of pine's web client, in one configuration: the web client, the SSH relay and the
// meeting service, a whole deployment. Every deployment is a Worker of its own made from this one
// configuration, named by its channel with `--name`, at pine-<channel>.<account>.workers.dev:
//
// - `pine-main`, deployed on every push to main: the project's service, which the apps use unless
//   the owner names another (`OFFICIAL_SERVICE` in desktop/src/machines.ts);
// - `pine-next`, deployed on every push to next;
// - `pine-pr-<number>`, deployed on every push to a pull request, and deleted when it is closed.
//
// `.github/workflows/web-preview.yml` deploys them (`npx wrangler deploy --name pine-<channel>`) and
// deletes a pull request's (`npx wrangler delete --name pine-pr-<number>`). A deployment of one's
// own does the same under a name of its own. A Worker that holds a Durable Object gets no version
// preview addresses, which is why each channel is a Worker of its own and not a version of one.
// `npx wrangler dev` serves the same locally.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The name when none is given: a deployment by hand without --name. The workflow always gives one.
  "name": "pine-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Each Worker's one address: pine-<channel>.<account>.workers.dev.
  "workers_dev": true,
  // A Worker that holds a Durable Object gets no version addresses.
  "preview_urls": false,
  // The web client's build (`npm run build` in web/), served by the same Worker: every request
  // goes through it first, which adds the headers of src/site.ts.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  // No logs of the bytes carried or of a meeting: the Worker writes none, and Workers Logs stay off.
  "observability": { "enabled": false },
  "ratelimits": [
    {
      // Connections per client IP: 20 a minute, for the relay and the meeting routes alike.
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // The meeting service: one object per machine id, holding that meeting's hibernating
  // sockets and no storage (src/meet-object.ts).
  "durable_objects": { "bindings": [{ "name": "MEET", "class_name": "Meeting" }] },
  // The free plan has Durable Objects backed by SQLite only; the class uses none of its storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meeting"] }],
  "vars": {
    // "on" serves the SSH relay at /ssh, for machines added as user@host; anything else refuses it.
    "RELAY": "on",
    // The servers that help a browser and a paired computer connect directly, which both read from /meet/config.
    "ICE": [{ "urls": "stun:stun.cloudflare.com:3478" }]
    // With "ANDROID_CERT_SHA256": the SHA-256 fingerprint of the key the Android app's releases
    // are signed with (AA:BB:..., from `keytool -list -v` or `apksigner verify --print-certs`),
    // the service serves /.well-known/assetlinks.json and its pairing links open the Pine app on
    // Android (App Links). Without it they open the browser. It is public: a variable, not a secret.
    // The app's App Link names pine-main alone (mobile/android/app/src/main/AndroidManifest.xml).
  }
}
